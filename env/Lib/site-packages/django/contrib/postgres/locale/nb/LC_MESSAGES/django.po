#: .\env\Lib\site-packages\django\contrib\postgres\apps.py:49
msgid "PostgreSQL extensions"
msgstr "PostgreSQL-utvidelser"

#: .\env\Lib\site-packages\django\contrib\postgres\fields\array.py:21
#: .\env\Lib\site-packages\django\contrib\postgres\forms\array.py:17
#: .\env\Lib\site-packages\django\contrib\postgres\forms\array.py:185
#, python-format
msgid "Item %(nth)s in the array did not validate:"
msgstr "Element %(nth)s i arrayen validerte ikke:"

#: .\env\Lib\site-packages\django\contrib\postgres\fields\array.py:22
msgid "Nested arrays must have the same length."
msgstr "Nøstede arrays må ha samme lengde."

#: .\env\Lib\site-packages\django\contrib\postgres\fields\hstore.py:15
msgid "Map of strings to strings/nulls"
msgstr "Oversikt over strenger til strenger/nulls"

#: .\env\Lib\site-packages\django\contrib\postgres\fields\hstore.py:17
#, python-format
msgid "The value of “%(key)s” is not a string or null."
msgstr "Verdien av \"%(key)s\" er ikke en streng eller null."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\hstore.py:17
msgid "Could not load JSON data."
msgstr "Kunne ikke laste JSON-data."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\hstore.py:18
msgid "Input must be a JSON dictionary."
msgstr "Input må være en JSON-dictionary."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:39
msgid "Enter two valid values."
msgstr "Oppgi to gyldige verdier."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:41
msgid "The start of the range must not exceed the end of the range."
msgstr "Starten på serien må ikke overstige enden av serien."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:96
msgid "Enter two whole numbers."
msgstr "Oppgi to heltall."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:102
msgid "Enter two numbers."
msgstr "Oppgi to tall."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:108
msgid "Enter two valid date/times."
msgstr "Oppgi to gyldige datoer og tidspunkter."

#: .\env\Lib\site-packages\django\contrib\postgres\forms\ranges.py:114
msgid "Enter two valid dates."
msgstr "Oppgi to gyldige datoer."

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:15
#, python-format
msgid ""
"List contains %(show_value)d item, it should contain no more than "
"%(limit_value)d."
msgid_plural ""
"List contains %(show_value)d items, it should contain no more than "
"%(limit_value)d."
msgstr[0] ""
"Listen inneholder %(show_value)d element, den bør ikke inneholde mer enn "
"%(limit_value)d."
msgstr[1] ""
"Listen inneholder %(show_value)d elementer, den bør ikke inneholde mer enn "
"%(limit_value)d."

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:25
#, python-format
msgid ""
"List contains %(show_value)d item, it should contain no fewer than "
"%(limit_value)d."
msgid_plural ""
"List contains %(show_value)d items, it should contain no fewer than "
"%(limit_value)d."
msgstr[0] ""
"Listen inneholder %(show_value)d element, den bør ikke inneholde færre enn "
"%(limit_value)d."
msgstr[1] ""
"Listen inneholder %(show_value)d elementer, den bør ikke inneholde færre enn "
"%(limit_value)d."

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:38
#, python-format
msgid "Some keys were missing: %(keys)s"
msgstr "Noen nøkler manglet: %(keys)s"

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:39
#, python-format
msgid "Some unknown keys were provided: %(keys)s"
msgstr "Noen ukjente nøkler ble oppgitt: %(keys)s"

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:81
#, python-format
msgid ""
"Ensure that this range is completely less than or equal to %(limit_value)s."
msgstr "Sørg for at denne serien er helt mindre enn eller lik %(limit_value)s."

#: .\env\Lib\site-packages\django\contrib\postgres\validators.py:90
#, python-format
msgid ""
"Ensure that this range is completely greater than or equal to "
"%(limit_value)s."
msgstr "Sørg for at denne serien er helt større enn eller lik %(limit_value)s."
